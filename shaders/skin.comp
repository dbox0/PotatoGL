#version 430 core
// Linear blend skinning: one thread per output vertex, every skinned instance in one dispatch.
// Writes plain GpuVertex (20 B), so all render passes draw the result with mesh.vert.
layout(local_size_x = 64) in;

struct Job {
    uint srcFirst;
    uint dstFirst;
    uint vertexCount;
    uint jointBase;
    uint firstGroup;
    uint pad0, pad1, pad2;
};

layout(std430, binding = 0) readonly buffer PosNormal { uvec4 posNormal[]; };  // xyz float bits, w packed normal
layout(std430, binding = 1) readonly buffer Skin { uvec2 skin[]; };            // 4 x u8 joints, 4 x unorm8 weights
layout(std430, binding = 2) readonly buffer Uvs { uint uvs[]; };
layout(std430, binding = 3) readonly buffer Palette { vec4 palette[]; };       // three rows per joint
layout(std430, binding = 4) readonly buffer Jobs { Job jobs[]; };
layout(std430, binding = 5) readonly buffer Groups { uint groups[]; };
layout(std430, binding = 6) writeonly buffer Out { uint outVertices[]; };

vec3 unpackNormal(uint bits) {
    int b = int(bits);
    ivec3 v = ivec3(bitfieldExtract(b, 0, 10), bitfieldExtract(b, 10, 10), bitfieldExtract(b, 20, 10));
    return max(vec3(v) / 511.0, vec3(-1.0));
}

uint packSnorm10(float v) {
    return uint(int(round(clamp(v, -1.0, 1.0) * 511.0))) & 0x3FFu;
}

void main() {
    Job job = jobs[groups[gl_WorkGroupID.x]];
    uint local = (gl_WorkGroupID.x - job.firstGroup) * 64u + gl_LocalInvocationID.x;
    if (local >= job.vertexCount)
        return;
    uint src = job.srcFirst + local;

    uvec4 pn = posNormal[src];
    uvec2 sk = skin[src];
    uvec4 joint = (uvec4(sk.x, sk.x >> 8, sk.x >> 16, sk.x >> 24) & 0xFFu) + job.jointBase;
    vec4 w = unpackUnorm4x8(sk.y);

    uvec4 base = joint * 3u;
    vec4 r0 = palette[base.x] * w.x + palette[base.y] * w.y + palette[base.z] * w.z + palette[base.w] * w.w;
    vec4 r1 = palette[base.x + 1u] * w.x + palette[base.y + 1u] * w.y + palette[base.z + 1u] * w.z + palette[base.w + 1u] * w.w;
    vec4 r2 = palette[base.x + 2u] * w.x + palette[base.y + 2u] * w.y + palette[base.z + 2u] * w.z + palette[base.w + 2u] * w.w;

    vec4 p = vec4(uintBitsToFloat(pn.xyz), 1.0);
    vec3 pos = vec3(dot(r0, p), dot(r1, p), dot(r2, p));
    vec3 n = unpackNormal(pn.w);
    n = vec3(dot(r0.xyz, n), dot(r1.xyz, n), dot(r2.xyz, n));
    float len2 = dot(n, n);
    n = len2 > 1e-12 ? n * inversesqrt(len2) : vec3(0.0, 1.0, 0.0);

    uint dst = (job.dstFirst + local) * 5u;
    outVertices[dst + 0u] = floatBitsToUint(pos.x);
    outVertices[dst + 1u] = floatBitsToUint(pos.y);
    outVertices[dst + 2u] = floatBitsToUint(pos.z);
    outVertices[dst + 3u] = packSnorm10(n.x) | packSnorm10(n.y) << 10 | packSnorm10(n.z) << 20;
    outVertices[dst + 4u] = uvs[src];
}
